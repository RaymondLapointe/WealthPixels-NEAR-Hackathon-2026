{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "scripts/near-public.ts",
    "test/near/**/*.test.ts",
    "scripts/verify-evidence.ts",
    "scripts/provision-role-key.ts",
    "scripts/transfer.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
